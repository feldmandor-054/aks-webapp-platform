# Normalise everything to LF in the repo and in working copies (shell scripts, Dockerfile,
# Terraform and YAML all break or churn under CRLF).
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.tf   text eol=lf
*.tpl  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
Dockerfile text eol=lf

*.png  binary
*.docx binary
